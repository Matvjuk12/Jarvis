# ─────────────────────────────────────────────────────────────────────────────
#  Jarvis configuration template.  Copy to ".env" and fill in your own values.
#      copy .env.example .env
#  NEVER commit ".env" — it is git-ignored. Only this example file belongs in the repo.
#  Everything can also be edited in the app: Settings tab.
#  Empty values are ignored. See docs/CONFIGURATION.md for every option.
# ─────────────────────────────────────────────────────────────────────────────

# ── Free LLM API keys (you need at least ONE) ───────────────────────────────
# Several keys per provider: comma-separated (KEY=a,b) or numbered (KEY_1, KEY_2).
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MODELSCOPE_API_KEY=
SILICONFLOW_API_KEY=
ZHIPU_API_KEY=

# Fully local alternative (install Ollama first): no key, no limits
# OLLAMA_ENABLED=1
# OLLAMA_MODEL=qwen2.5:7b

# Override a model if the provider renamed/retired it (<PROVIDER>_MODEL)
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash

# ── Speech recognition ──────────────────────────────────────────────────────
# LANGUAGES=ru,en                 # ru | en | ru,en
# WHISPER=1                       # 0 = Vosk only
# WHISPER_MODEL=small             # tiny | base | small | medium | large-v3-turbo
# WHISPER_DEVICE=cpu              # cpu | cuda
# VOSK_MODEL=./model              # optional: live text while speaking
# MIC_DEVICE=                     # device number (see: python jarvis.py --mic-test)
# MIC_THRESHOLD=250               # lower for quiet mics, higher for noisy rooms
# END_SILENCE=0.9                 # seconds of silence that end a phrase

# ── Activation and edit window ──────────────────────────────────────────────
# WAKE_MODE=open                  # open | hybrid | strict
# WAKE_WORDS=jarvis,джарвис       # phonetic match: "jarvis" also matches "Джарвис"
# AUTO_SEND_SECONDS=3             # countdown before the text runs
# EDIT_WINDOW=1                   # 0 = no edit window, run instantly
# POPUP_POS=right-bottom          # right|left - top|middle|bottom (drag to move; position is remembered)
# POPUP_WIDTH=440

# ── Voice ────────────────────────────────────────────────────────────────────
# TTS_ENGINE=edge                 # edge (online) | pyttsx3 (offline)
# EDGE_VOICE_RU=ru-RU-DmitryNeural
# EDGE_VOICE_EN=en-GB-RyanNeural
# TTS_RATE_EDGE=-5%
# TTS_PITCH=-2Hz
# TTS_FALLBACK=1                  # 0 = stay silent if Edge fails

# ── Misc ─────────────────────────────────────────────────────────────────────
# JARVIS_PORT=47615               # local port used by the app (127.0.0.1 only)
